{% extends "pages/base.twig" %}

{% block content %}

	<style>
		.panel {
			background: #f2f2f2;
			padding: 16px;
			border-radius: 4px;
		}
		.list-box {
			height: 390px;
			overflow-y: auto;
			background: #eef1f6;
			border: 1px solid #b9c0cc;
			border-radius: 4px;
			padding: 10px;
			outline: none;
		}
		.list-box:focus {
			border: 2px solid #495057;
		}
		.group-title {
			font-weight: 700;
			margin-bottom: 4px;
		}
		.item {
			padding: 2px 4px 2px 16px;
			cursor: pointer;
			user-select: none;
		}
		.item:hover {
			background: #dde3ec;
		}
		.item.sel {
			background: #0b57d0;
			color: #fff;
		}
		.item .mail {
			color: #0d6efd;
		}
		.item.sel .mail {
			color: #fff;
		}
		.btn-orange {
			background: #f0a071;
			border-color: #f0a071;
			color: #fff;
		}
		.btn-orange.active-on {
			background: #f26522;
			border-color: #f26522;
		}
		.btn-orange:hover {
			color: #fff;
		}
	</style>

	<div class="panel">
		<div class="row g-4">
			<!-- ESQUERDA: existentes -->
			<div class="col-lg-5">
				<label class="form-label mb-1">Usuários existentes</label>
				<div class="list-box" id="boxLeft" tabindex="0" data-side="left"></div>
				<div class="d-flex align-items-center gap-2 mt-2">
					<span>Buscar</span>
					<input class="form-control form-control-sm" id="searchLeft" style="max-width:200px">
					<button class="btn btn-sm btn-orange active-on" data-clear="left">Limpar</button>
				</div>
			</div>

			<!-- Buttons -->
			<div class="col-lg-2 d-flex flex-column justify-content-center gap-4">
				<button class="btn btn-orange" id="btnAdd">&#9664; Adicionar</button>
				<button class="btn btn-orange" id="btnRemove">Remover &#9654;</button>
			</div>

			<!-- DIREITA: potenciais -->
			<div class="col-lg-5">
				<label class="form-label mb-1">Usuários potenciais</label>
				<div class="list-box" id="boxRight" tabindex="0" data-side="right"></div>
				<div class="d-flex align-items-center gap-2 mt-2">
					<span>Buscar</span>
					<input class="form-control form-control-sm" id="searchRight" style="max-width:200px">
					<button class="btn btn-sm btn-orange active-on" data-clear="right">Limpar</button>
				</div>
			</div>
		</div>
	</div>
	
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	<script>

		const data = {
			left: {{ (ASSIGNED_USERS ?? [])|json_encode|raw }},
			right: {{ (UNASSIGNED_USERS ?? [])|json_encode|raw }}
		};

		const sel = { left: new Set(), right: new Set() };
		const anchor = { left: null, right: null };
		const cursor = { left: null, right: null };
		const titles = { left: "Usuários existentes", right: "Usuários potenciais" };

		const visible = (side) =>
			data[side].filter((u) => {
				const t = document
					.getElementById(side === "left" ? "searchLeft" : "searchRight")
					.value.trim()
					.toLowerCase();
				return !t || (u.name + " " + u.email).toLowerCase().includes(t);
			});

		function render() {
			["left", "right"].forEach((side) => {
				const list = visible(side);
				const box = document.getElementById(
					side === "left" ? "boxLeft" : "boxRight",
				);
				box.innerHTML = list.length
					? `<div class="group-title">${titles[side]} (${list.length})</div>` +
						list
							.map(
								(
									u,
								) => `<div class="item ${sel[side].has(u.id) ? "sel" : ""}" data-id="${u.id}" data-side="${side}">
             ${u.name} (<span class="mail">${u.email}</span>)</div>`,
							)
							.join("")
					: `<div class="group-title">Nenhum</div>`;
			});
			document
				.getElementById("btnAdd")
				.classList.toggle("active-on", sel.right.size > 0);
			document
				.getElementById("btnRemove")
				.classList.toggle("active-on", sel.left.size > 0);
		}

		function selectRange(side, a, b) {
			const ids = visible(side).map((u) => u.id);
			const i = ids.indexOf(a),
				j = ids.indexOf(b);
			if (i < 0 || j < 0) return;
			sel[side].clear();
			ids.slice(Math.min(i, j), Math.max(i, j) + 1).forEach((id) =>
				sel[side].add(id),
			);
		}

		/* ---- mouse: clique, Shift (intervalo), Ctrl (avulso) ---- */
		document.addEventListener("click", (e) => {
			const el = e.target.closest(".item");
			if (!el) return;
			const side = el.dataset.side,
				id = +el.dataset.id;

			if (e.shiftKey && anchor[side] !== null) {
				selectRange(side, anchor[side], id);
			} else if (e.ctrlKey || e.metaKey) {
				sel[side].has(id) ? sel[side].delete(id) : sel[side].add(id);
				anchor[side] = id;
			} else {
				sel[side].clear();
				sel[side].add(id);
				anchor[side] = id;
			}
			cursor[side] = id;
			const other = side === "left" ? "right" : "left";
			sel[other].clear();
			anchor[other] = null;
			document.getElementById(side === "left" ? "boxLeft" : "boxRight").focus();
			render();
		});

		/* ---- teclado: setas ↑↓ movem; Shift+↑↓ estendem seleção ---- */
		["boxLeft", "boxRight"].forEach((bid) => {
			document.getElementById(bid).addEventListener("keydown", (e) => {
				const side = e.currentTarget.dataset.side;
				const ids = visible(side).map((u) => u.id);
				if (!ids.length) return;

				if (e.key === "ArrowDown" || e.key === "ArrowUp") {
					e.preventDefault();
					let i = ids.indexOf(cursor[side]);
					i =
						i < 0
							? 0
							: Math.min(
									ids.length - 1,
									Math.max(0, i + (e.key === "ArrowDown" ? 1 : -1)),
								);
					cursor[side] = ids[i];
					if (e.shiftKey) {
						if (anchor[side] === null) anchor[side] = ids[i];
						selectRange(side, anchor[side], cursor[side]);
					} else {
						sel[side].clear();
						sel[side].add(cursor[side]);
						anchor[side] = cursor[side];
					}
					render();
					e.currentTarget
						.querySelector(".item.sel")
						?.scrollIntoView({ block: "nearest" });
				}
				if (e.key === "Enter" || e.key === " ") {
					e.preventDefault();
					side === "right" ? move("right", "left") : move("left", "right");
				}
			});
		});

		function move(from, to) {
			const moved = data[from].filter((u) => sel[from].has(u.id));
			if (!moved.length) return;
			data[from] = data[from].filter((u) => !sel[from].has(u.id));
			data[to] = data[to].concat(moved);
			sel[from].clear();
			anchor[from] = null;
			cursor[from] = null;
			render();
		}
		document.getElementById("btnAdd").onclick = () => move("right", "left");
		document.getElementById("btnRemove").onclick = () => move("left", "right");

		["searchLeft", "searchRight"].forEach((i) =>
			document.getElementById(i).addEventListener("input", render),
		);
		document.querySelectorAll("[data-clear]").forEach(
			(b) =>
				(b.onclick = () => {
					document.getElementById(
						b.dataset.clear === "left" ? "searchLeft" : "searchRight",
					).value = "";
					render();
				}),
		);

		render();
	</script>	

{% endblock %}
