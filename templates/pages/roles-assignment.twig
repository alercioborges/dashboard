{% extends "pages/base.twig" %}

{% block content %}
    {{ message('message')|raw }}

    {% if ROLES is not empty %}
        <div class="card-body table-responsive p-0">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th scope="col">Nome</th>
                        <th scope="col">Descrição</th>
                        <th scope="col">Usuários com papel</th>
                    </tr>
                </thead>
                <tbody class="table-group-divider">


                    {% for data in ROLES %}
                        <tr class="align-middle">                            
                            <td>
                                {{ data.name }}
                            </td>
                            <td>
                                {{ data.description }}
                            </td>

                    {% endfor %}
                    
                </tbody>
            </table>

            {{ pagination(NUM_PAGES, CURRENT_PAGE) }}
        </div>
    {% else %}
        <div class="alert alert-danger mt-1" role="alert">
            <strong>Nenhum perfil de usuário encontrado</strong>
        </div>
    {% endif %}

    <pre>{{ dump(ROLES) }}</pre>

{% endblock %}